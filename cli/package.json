{
  "name": "@proofperks/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProofPerks compile, deploy, and interaction CLI workspace.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuryaXyz-art/Proofperks.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/SuryaXyz-art/Proofperks/issues"
  },
  "homepage": "https://github.com/SuryaXyz-art/Proofperks#readme",
  "scripts": {
    "compile": "node src/compile.mjs",
    "deploy": "node src/deploy.mjs",
    "deploy:preprod": "node --experimental-strip-types src/preprod-deploy.ts",
    "fund:preprod": "node --experimental-strip-types src/preprod-ops.ts fund",
    "verify:preprod": "node --experimental-strip-types src/preprod-ops.ts verify",
    "smoke:preprod": "node --experimental-strip-types src/preprod-smoke.ts",
    "interact": "node src/interact.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "demo": "node --experimental-strip-types demo.ts",
    "pilot:load": "node load-test.mjs",
    "pilot:export": "node export-pilot-metrics.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js": "4.1.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "rxjs": "7.8.2"
  }
}
